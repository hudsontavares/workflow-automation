PORT=3000
MONGODB_URI=mongodb://localhost:27117/workflow-automation
# The https address printed by `ngrok http 3000`, where GitHub delivers webhooks
PUBLIC_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Random values of at least 32 characters, e.g. from https://1password.com/password-generator
GITHUB_WEBHOOK_SECRET=
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=
# Optional: enables the Copilot, from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
